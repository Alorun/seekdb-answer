drop database if exists fts_count_only;
create database fts_count_only;
use fts_count_only;
create table single_t (id int primary key, content text);
create table part_t (id int primary key, content text) partition by hash(id) partitions 4;
insert into single_t values
(1, '数据库 全文索引'),
(2, '倒排索引 tokenizer'),
(3, '数据库'),
(4, '索引 tokenizer'),
(5, '无关内容'),
(6, '数据库 tokenizer 索引'),
(7, 'tokenizer'),
(8, '数据库 倒排索引');
insert into part_t select * from single_t;
alter table single_t add fulltext index f(content) with parser ik;
alter table part_t add fulltext index f(content) with parser ik;
# shape 1: bare COUNT(*) is answered without materializing the id
select count(*) from single_t where match(content) against('数据库 tokenizer');
count(*)
7
select count(*) from part_t where match(content) against('数据库 tokenizer');
count(*)
7
# shape 2: SELECT id keeps materializing it
select id from single_t where match(content) against('数据库 tokenizer') order by id;
id
1
2
3
4
6
7
8
select id from part_t where match(content) against('数据库 tokenizer') order by id;
id
1
2
3
4
6
7
8
# shape 3: an aggregate over id keeps materializing it
select count(*), sum(id), min(id), max(id) from single_t where match(content) against('数据库 tokenizer');
count(*)	sum(id)	min(id)	max(id)
7	31	1	8
select count(*), sum(id), min(id), max(id) from part_t where match(content) against('数据库 tokenizer');
count(*)	sum(id)	min(id)	max(id)
7	31	1	8
# the id based shapes see exactly the rows the count-only shape counts
select count(*) from (select id from single_t where match(content) against('数据库 tokenizer')) t;
count(*)
7
# a filter on the row also reads it, so count(*) with a filter must agree
select count(*) from single_t where match(content) against('数据库 tokenizer') and id > 3;
count(*)
4
select count(*) from part_t where match(content) against('数据库 tokenizer') and id > 3;
count(*)
4
# single token match runs the plain merge path and must agree
select count(*) from single_t where match(content) against('tokenizer');
count(*)
4
select count(*) from part_t where match(content) against('tokenizer');
count(*)
4
# repeated execution of the count-only shape must stay stable
select count(*) from single_t where match(content) against('数据库 tokenizer');
count(*)
7
select count(*) from single_t where match(content) against('数据库 tokenizer');
count(*)
7
# many rows over four tablets: the count must survive batch boundaries and
# tablet switches (1024 rows, several 256 row batches per tablet)
create table big_t (id int primary key, content text) partition by hash(id) partitions 4;
insert into big_t values
(1, '数据库 tokenizer'), (2, '数据库 tokenizer'), (3, '数据库 tokenizer'),
(4, '数据库 tokenizer'), (5, '数据库 tokenizer'), (6, '数据库 tokenizer'),
(7, '数据库 tokenizer'), (8, '数据库 tokenizer');
insert into big_t select id + 8, content from big_t;
insert into big_t select id + 16, content from big_t;
insert into big_t select id + 32, content from big_t;
insert into big_t select id + 64, content from big_t;
insert into big_t select id + 128, content from big_t;
insert into big_t select id + 256, content from big_t;
insert into big_t select id + 512, content from big_t;
alter table big_t add fulltext index f(content) with parser ik;
select count(*) from big_t where match(content) against('数据库 tokenizer');
count(*)
1024
select count(*), sum(id), min(id), max(id) from big_t where match(content) against('数据库 tokenizer');
count(*)	sum(id)	min(id)	max(id)
1024	524800	1	1024
select count(*) from big_t where match(content) against('数据库 tokenizer') and id > 500;
count(*)
524
select count(*) from big_t where match(content) against('tokenizer');
count(*)
1024
drop database fts_count_only;
